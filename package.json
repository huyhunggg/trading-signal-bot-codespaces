{
  "name": "confluence-signal-bot",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "Local crypto futures alert bot: closed-candle confluence and intrabar impulse alerts",
  "engines": {
    "node": ">=24.5.0"
  },
  "scripts": {
    "trade:binance": "node --use-env-proxy --env-file-if-exists=.env src/binance-live-main.js",
    "okx:demo:setup": "node scripts/setup-okx-demo.js",
    "okx:demo": "node --use-env-proxy --env-file-if-exists=.env --env-file-if-exists=.env.okx-demo src/main.js --okx-demo",
    "okx:demo:pause": "node --env-file-if-exists=.env scripts/okx-demo-control.js pause",
    "okx:demo:resume": "node --env-file-if-exists=.env scripts/okx-demo-control.js resume",
    "start": "node --use-env-proxy --env-file-if-exists=.env src/main.js",
    "demo": "node src/paper-main.js",
    "paper": "node --use-env-proxy src/paper-main.js --live",
    "paper:binance": "node --use-env-proxy src/paper-main.js --live --binance",
    "check": "node --use-env-proxy --env-file-if-exists=.env src/main.js --check",
    "test": "node --test",
    "calibrate": "node --use-env-proxy --env-file-if-exists=.env scripts/calibrate.js",
    "telegram:check": "node --use-env-proxy --env-file-if-exists=.env scripts/telegram-check.js",
    "telegram:chat": "node --use-env-proxy --env-file-if-exists=.env scripts/telegram-chat.js"
  },
  "dependencies": {
    "proxy-agent": "^6.5.0",
    "ws": "^8.18.3"
  }
}

