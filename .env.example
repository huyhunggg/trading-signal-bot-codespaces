# Public market data; NO exchange API key is required.
EXCHANGE=binance
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
TIMEFRAMES=5m,15m
HTF=1h
# Alternative to RSI Hook. Set false to compare Hook-only signals.
PINBAR_ENABLED=true
HISTORY_BARS=650
SIGNAL_MAX_AGE_SECONDS=120
STREAM_STALE_SECONDS=90
DATA_DIR=./data
# Local dashboard; keep loopback binding when running on your own computer.
HOST=127.0.0.1
PORT=8787
# Create your own bot with Telegram @BotFather; keep its token private.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
