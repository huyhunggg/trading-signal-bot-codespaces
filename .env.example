# Public market data; NO exchange API key is required.
EXCHANGE=okx
# auto keeps one consistent venue at a time; fixed disables fallback.
DATA_SOURCE_MODE=auto
REST_MIN_INTERVAL_MS=350
POLL_INTERVAL_SECONDS=5
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
TIMEFRAMES=5m,15m
HTF=1h
# Alternative to RSI Hook. Set false to compare Hook-only signals.
PINBAR_ENABLED=true
HISTORY_BARS=650
SIGNAL_MAX_AGE_SECONDS=120
STREAM_STALE_SECONDS=90
DATA_DIR=./data
# Local dashboard; keep loopback binding when running on your own computer.
HOST=127.0.0.1
PORT=8787
# Create your own bot with Telegram @BotFather; keep its token private.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Historical validation: wins mean positive TOTAL result after assumed costs.
# Official notifications require the 95% Wilson LOWER bound to meet this target.
MIN_WIN_RATE_PERCENT=80
AUTO_CALIBRATE=true
VALIDATION_HEAP_MB=256
VALIDATION_MIN_SAMPLES=100
VALIDATION_DAYS=180
VALIDATION_MAX_AGE_DAYS=7
VALIDATION_MAX_HOLD_BARS=48
# Assumptions, not your account's verified fee/funding schedule; bps = 0.01%.
VALIDATION_FEE_BPS=6
VALIDATION_SLIPPAGE_BPS=2
VALIDATION_FUNDING_BPS_8H=1

# Optional real Binance Futures mode: npm run trade:binance.
# Never commit actual credentials. Default is read-only; no trade writes.
BOT_MODE=alerts
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_LIVE_ENABLED=false
BINANCE_MAX_NOTIONAL_USDT=25
BINANCE_MAX_RISK_USDT=1
BINANCE_MAX_DAILY_LOSS_USDT=5
DASHBOARD_USER=bot
DASHBOARD_PASSWORD=
LIVE_DATA_DIR=./live-data
# Optional ISO deadline from Binance, including timezone; only delays requests.
BINANCE_RETRY_NOT_BEFORE=

